// Convierte este schema de Prisma a formato database.build, incluyendo:
// - Todas las tablas con sus columnas y tipos de datos
// - Claves primarias (pk)
// - Claves foráneas (fk) con sus relaciones
// - Campos únicos (unique)
// - Valores por defecto cuando sean relevantes
// - Omite de las tablas los valores createdAt y updatedAt

// -------------------------------------------
// refactoriza el orden de las tablas para que la creacion
// de las tablas se hagan en el orden correcto
// -------------------------------------------

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Estado {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstadoPais {
  id         Int         @id @default(autoincrement())
  estado     String
  vigencia   Boolean     @default(true)
  municipios Municipio[]

  @@map("estado_pais")
}

model Municipio {
  id        Int        @id @default(autoincrement())
  estadoId  Int
  nombre    String
  vigencia  Boolean    @default(true)
  estado    EstadoPais @relation(fields: [estadoId], references: [id])
  poblados  Poblado[]

  @@index([estadoId])
  @@map("municipio")
}

model Poblado {
  id                 Int               @id @default(autoincrement())
  municipioId        Int
  nombre             String
  vigencia           Boolean           @default(true)
  municipio          Municipio         @relation(fields: [municipioId], references: [id])
  zonasUrbanizacion  ZonaUrbanizacion[]

  @@index([municipioId])
  @@map("poblado")
}

model ZonaUrbanizacion {
  id           Int      @id @default(autoincrement())
  pobladoId    Int
  codigoPostal Int
  zona         String
  vigencia     Boolean  @default(true)
  poblado      Poblado  @relation(fields: [pobladoId], references: [id])

  @@index([pobladoId])
  @@index([codigoPostal])
  @@map("zona_urbanizacion")
}

model Usuario {

  id             Int        @id @default(autoincrement())
  primerNombre   String
  primerApellido String
  avatar         String?
  telefono       String
  cedula         String     @unique
  email          String     @unique
  password       String
  Bitacora       Bitacora[]
  rol            Rol        @default(READER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Bitacora {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  type    AccionesBitacora
  fecha   DateTime         @default(now())
  mensaje String?
}

enum AccionesBitacora {
  LOGIN
  CREATE_ADMIN
  CREATE_USER
  UPDATE_ADMIN
  UPDATE_USER
  DELETE_ADMIN
  DELETE_USER
  VIEW
  ERROR
  GET_USUARIOS
}

enum Rol {
  ADMIN
  EDITOR
  READER
}
